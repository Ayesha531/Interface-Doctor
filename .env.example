# Server-side only — never expose these to the browser.
# Add real values in the workspace Secrets panel; do NOT commit a .env file.
# After adding or changing a secret, restart the dev server so Next.js loads it.

# API key for the vision-capable AI provider (used by /api/analyze on the server).
OPENAI_API_KEY=

# AI provider identifier. Currently only "openai" is implemented; kept as a
# variable so additional providers can be added without client changes.
AI_PROVIDER=

# Vision model used for screenshot diagnosis (OpenAI-compatible vision model).
AI_VISION_MODEL=

# Postgres connection string used for project persistence (server-side only).
# If missing, the app falls back to browser localStorage for recent projects.
DATABASE_URL=

# Secret used to sign the anonymous client token cookie for project scoping.
# If missing, localStorage is used instead of the database.
SESSION_SECRET=
